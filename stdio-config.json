{
  "name": "swift-mcp-server",
  "version": "1.0.0",
  "description": "Swift MCP Server for Serena MCP integration with SourceKit-LSP support",
  "mcpServer": {
    "transport": {
      "type": "stdio",
      "host": "127.0.0.1",
      "port": 8080,
      "portRange": {
        "min": 8080,
        "max": 8090
      },
      "autoPortSelection": true,
      "httpFallback": true
    },
    "capabilities": {
      "tools": ["find_symbols", "find_references", "get_definition", "get_hover_info", "format_document", "get_diagnostics"],
      "resources": ["swift://workspace"],
      "experimental": {
        "swiftLanguageSupport": true,
        "sourceKitLSP": true,
        "modernConcurrency": true,
        "aiCodeAnalysis": false
      }
    }
  },
  "serenaIntegration": {
    "languageSupport": "swift",
    "tools": {
      "findSymbol": {
        "namePatterns": ["class", "function", "method", "variable", "protocol", "enum"],
        "searchTypes": ["substring", "exact", "regex"]
      },
      "findReferencingSymbols": {
        "supportedTypes": ["classes", "methods", "functions", "variables"]
      },
      "symbolOperations": {
        "insertAfterSymbol": true,
        "insertBeforeSymbol": true,
        "replaceSymbolBody": true
      }
    }
  },
  "requirements": {
    "swift": ">=5.9",
    "macos": ">=13.0",
    "sourceKitLSP": ">=1.0.0"
  }
}
